---
import { CAPAS } from '../data/stack';

const laminas = ['Marx', 'Frontend', 'Backend', 'Datos'];
// la pila se dibuja de abajo hacia arriba: datos, backend y frontend
const ALTURAS = { datos: -1, backend: 0, frontend: 1 };
const todas = CAPAS.flatMap((capa) => capa.tecnologias.map((t) => ({ ...t, tinte: capa.tinte })));
---

<!--
  La pila full-stack: tres capas isométricas con una ficha por tecnología.
  Todo es HTML y CSS 3D; `hero.ts` la mueve y rota la portada.
-->
<section id="hero" class="hero zona-oscura" data-tono="0">
  <!-- un fondo por lámina: se funden entre sí al cambiar de portada -->
  {laminas.map((_, i) => <div class={`hero__fondo hero__fondo--${i}`} aria-hidden="true" />)}
  <div class="hero__velo" aria-hidden="true"></div>
  <div class="hero__trama" aria-hidden="true"></div>

  <div class="pila" data-pila aria-hidden="true">
    <div class="pila__escena" data-escena>
      {CAPAS.map((capa) => (
        <div class="capa" data-capa={capa.id} style={`--tinte:${capa.tinte};--nivel:${ALTURAS[capa.id]}`}>
          <span class="capa__nombre">{capa.nombre}</span>
          {capa.tecnologias.map((t) => (
            <div
              class="ficha"
              data-ficha
              data-capa={capa.id}
              data-capa-nombre={capa.nombre}
              data-nombre={t.nombre}
              data-nota={t.nota}
              style={`--tinte:${capa.tinte}`}
            >
              <svg viewBox="0 0 24 24" fill={t.color}><path d={t.trazo} /></svg>
              <span>{t.nombre}</span>
            </div>
          ))}
        </div>
      ))}
      <!-- los cuatro pilares por los que suben y bajan los datos -->
      {[0, 1, 2, 3].map((i) => <i class={`pilar pilar--${i}`} />)}
    </div>
  </div>

  <!-- qué ficha está encendida -->
  <div class="pila__lectura" aria-hidden="true">
    <span class="hud hud--mute">stack.focus()</span>
    <b data-foco="nombre">React</b>
    <span class="pila__capa" data-foco="capa">Frontend</span>
    <span class="pila__nota" data-foco="nota">Interfaces por componentes</span>
  </div>

  <!-- lecturas del monitor -->
  <div class="hero__lecturas">
    <span class="lectura">Ubicación <b>Lima, PE</b></span>
    <span class="lectura">Hora local <b class="mono-num" data-lectura="hora">--:--:--</b></span>
    <span class="lectura">Experiencia <b class="mono-num">3</b> años</span>
    <span class="lectura">Estado <b>Disponible</b></span>
  </div>

  <div class="hero__grande">
    <span class="hud hud--mute">Webs en producción</span>
    <b class="mono-num hero__cifra">07</b>
  </div>

  <!--
    Portada rotativa: cuatro láminas en la misma celda. La primera lleva las
    animaciones de entrada y es la única visible sin JS; `hero.ts` las rota.
    `data-capa` dice qué capa de la pila resalta cada una.
  -->
  <div class="hero__texto" data-portada>
    <div class="hero__laminas">
      <div class="hero__lamina" data-lamina data-tono="0" data-activa>
        <span class="hud hero__claim anim-fade" style="animation-delay:.7s">
          Ingeniero de Software · Lima, Perú
        </span>

        <h1 class="display hero__titulo">
          <span class="mask"><span class="anim-rise">Marx</span></span>
          <span class="mask">
            <span class="anim-rise" style="animation-delay:.1s">
              <span class="fill-word" data-word="Chipana">Chipana</span>
            </span>
          </span>
          <span class="mask">
            <span class="anim-rise" style="animation-delay:.2s">Full-Stack <em>Dev</em></span>
          </span>
        </h1>

        <p class="hero__bajada anim-fade" style="animation-delay:.9s">
          3 años construyendo aplicaciones web de punta a punta: del diseño de la interfaz al
          despliegue en producción.
        </p>

        <div class="hero__acciones anim-fade" style="animation-delay:1.1s">
          <a href="#proyectos" class="cta cta--azul"><i></i>Ver proyectos</a>
          <a href="#terminal" class="cta cta--linea">Abrir terminal</a>
          <a href="Contacto" class="cta cta--linea">Contáctame</a>
        </div>
      </div>

      <div class="hero__lamina" data-lamina data-tono="1" data-capa="frontend" aria-hidden="true" inert>
        <span class="hud hero__claim">React · Next.js · Astro · Angular</span>

        <h2 class="display hero__titulo">
          <span class="mask"><span>Frontend</span></span>
          <span class="mask">
            <span><span class="fill-word" data-word="interactivo">interactivo</span></span>
          </span>
          <span class="mask"><span>y <em>responsive</em></span></span>
        </h2>

        <p class="hero__bajada">
          Interfaces rápidas, animadas y cuidadas al detalle con TypeScript y Tailwind, que se ven
          bien en cualquier pantalla.
        </p>

        <div class="hero__acciones">
          <a href="#proyectos" class="cta cta--azul"><i></i>Webs que desarrollé</a>
          <a href="https://github.com/MarxAlonso" target="_blank" rel="noopener noreferrer" class="cta cta--linea">
            GitHub
          </a>
        </div>
      </div>

      <div class="hero__lamina" data-lamina data-tono="2" data-capa="backend" aria-hidden="true" inert>
        <span class="hud hero__claim">NestJS · FastAPI · Go · Spring Boot</span>

        <h2 class="display hero__titulo">
          <span class="mask"><span>Backend</span></span>
          <span class="mask">
            <span><span class="fill-word" data-word="escalable">escalable</span></span>
          </span>
          <span class="mask"><span>en <em>producción</em></span></span>
        </h2>

        <p class="hero__bajada">
          APIs y servicios en Node.js, Python, Go, Java y PHP, pensados para crecer y mantenerse
          en el tiempo.
        </p>

        <div class="hero__acciones">
          <a href="#experiencia" class="cta cta--azul"><i></i>Ver experiencia</a>
          <a
            href="https://www.linkedin.com/in/marx-alonso-chipana"
            target="_blank"
            rel="noopener noreferrer"
            class="cta cta--linea"
          >
            LinkedIn
          </a>
        </div>
      </div>

      <div class="hero__lamina" data-lamina data-tono="3" data-capa="datos" aria-hidden="true" inert>
        <span class="hud hero__claim">PostgreSQL · MySQL · Git · Deploy</span>

        <h2 class="display hero__titulo">
          <span class="mask"><span>Datos</span></span>
          <span class="mask">
            <span><span class="fill-word" data-word="ordenados">ordenados</span></span>
          </span>
          <span class="mask"><span>y <em>en línea</em></span></span>
        </h2>

        <p class="hero__bajada">
          Bases de datos en PostgreSQL y MySQL, versiones con Git y despliegues en Netlify y
          Cloudflare. También sitios en WordPress.
        </p>

        <div class="hero__acciones">
          <a href="#terminal" class="cta cta--azul"><i></i>Abrir terminal</a>
          <a href="Contacto" class="cta cta--linea">Contáctame</a>
        </div>
      </div>
    </div>

    <!-- las rayas: una por lámina, cada una con el color de su portada -->
    <div class="hero__pasos anim-fade" style="animation-delay:1.3s" aria-label="Portadas">
      {laminas.map((nombre, i) => (
        <button
          type="button"
          class="hero__paso"
          data-paso={i}
          data-tono={i}
          aria-label={`Portada ${i + 1}: ${nombre}`}
          aria-current={i === 0 ? 'true' : undefined}
        >
          <span class="hero__paso-nombre"><span class="mono-num">0{i + 1}</span> {nombre}</span>
          <i></i>
        </button>
      ))}
    </div>
  </div>

  <!-- cinta con todo el stack; la segunda copia solo existe para el bucle -->
  <div class="cinta">
    {[0, 1].map((copia) => (
      <ul class="cinta__lista" aria-hidden={copia === 1 ? 'true' : undefined} aria-label={copia === 0 ? 'Tecnologías' : undefined}>
        {todas.map((t) => (
          <li>
            <svg viewBox="0 0 24 24" fill={t.color} aria-hidden="true"><path d={t.trazo} /></svg>
            {t.nombre}
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<script>
  import { iniciarHero } from '../scripts/hero';
  iniciarHero();
</script>

<style>
  .hero {
    --cinta: 46px;
    /* margen lateral del contenido: en pantallas anchas lo centra en un marco
       de 1280px en vez de dejarlo pegado al borde */
    --margen: max(var(--pad), calc(50vw - 640px));
    position: relative;
    isolation: isolate;
    /* a sangre: compensa el padding del body y pasa por debajo del rail */
    margin-inline: calc(-1rem - var(--rail)) -1rem;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero { min-height: 660px; }
  }
  @media (max-width: 760px) {
    /* en móvil descuenta la barra superior */
    .hero { height: calc(100svh - 60px); min-height: 600px; }
  }

  /* ---------- fondo ---------- */
  .hero__fondo {
    position: absolute;
    inset: -4%;
    z-index: 0;
    transition: opacity 1.2s ease;
  }
  .hero__fondo--0 {
    background:
      radial-gradient(46% 50% at 72% 48%, rgba(4, 48, 207, 0.42), transparent 70%),
      radial-gradient(40% 40% at 18% 14%, rgba(94, 211, 255, 0.1), transparent 70%),
      var(--fondo);
  }
  .hero__fondo--1 {
    background:
      radial-gradient(46% 50% at 72% 48%, rgba(109, 40, 217, 0.5), transparent 70%),
      radial-gradient(40% 40% at 18% 14%, rgba(94, 211, 255, 0.1), transparent 70%),
      var(--fondo);
  }
  .hero__fondo--2 {
    background:
      radial-gradient(46% 50% at 72% 48%, rgba(16, 122, 85, 0.5), transparent 70%),
      radial-gradient(40% 40% at 18% 14%, rgba(47, 123, 255, 0.14), transparent 70%),
      var(--fondo);
  }
  .hero__fondo--3 {
    background:
      radial-gradient(46% 50% at 72% 48%, rgba(180, 83, 9, 0.46), transparent 70%),
      radial-gradient(40% 40% at 18% 14%, rgba(47, 123, 255, 0.14), transparent 70%),
      var(--fondo);
  }
  .hero__fondo--1,
  .hero__fondo--2,
  .hero__fondo--3 { opacity: 0; }
  .hero[data-tono='1'] .hero__fondo--1,
  .hero[data-tono='2'] .hero__fondo--2,
  .hero[data-tono='3'] .hero__fondo--3 { opacity: 1; }

  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, var(--fondo) 0%, rgba(5, 7, 15, 0.8) 28%, transparent 60%),
      linear-gradient(180deg, rgba(5, 7, 15, 0.5), transparent 26%, transparent 74%, var(--fondo));
  }
  /* trama de puntos, como papel milimetrado */
  .hero__trama {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.16) 1px, transparent 1.4px) 0 0 / 26px 26px;
    -webkit-mask-image: radial-gradient(60% 70% at 70% 48%, #000, transparent 75%);
    mask-image: radial-gradient(60% 70% at 70% 48%, #000, transparent 75%);
  }

  /* ---------- la pila ---------- */
  .pila {
    --lado: 318px;
    --salto: 178px;
    position: absolute;
    /* la pila se ancla al centro, no a un porcentaje del ancho */
    left: calc(50% + min(21%, 310px));
    top: 46%;
    z-index: 3;
    width: 0;
    height: 0;
  }
  .pila__escena {
    position: absolute;
    transform-style: preserve-3d;
    transform:
      translateY(var(--flote, 0px))
      rotateX(calc(58deg + var(--inclinacion, 0deg)))
      rotateZ(calc(-42deg + var(--giro, 0deg)));
  }

  .capa {
    position: absolute;
    left: calc(var(--lado) / -2);
    top: calc(var(--lado) / -2);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: var(--lado);
    height: var(--lado);
    padding: 14px;
    border: 1px solid color-mix(in srgb, var(--tinte) 55%, transparent);
    border-radius: 20px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--tinte) 16%, rgba(7, 10, 20, 0.55)),
      color-mix(in srgb, var(--tinte) 4%, rgba(7, 10, 20, 0.35))
    );
    box-shadow:
      0 0 70px color-mix(in srgb, var(--tinte) 22%, transparent),
      inset 0 0 30px color-mix(in srgb, var(--tinte) 10%, transparent);
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--nivel) * var(--salto) + var(--extra, 0px)));
    transition:
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.7s ease;
  }
  /* El nombre cuelga de la esquina derecha de su capa. Deshace el giro de la
     escena para quedar de frente, como un cartel, y no pisar la capa de abajo. */
  .capa__nombre {
    position: absolute;
    left: 100%;
    top: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 150px;
    transform-origin: 0 0;
    transform:
      rotateZ(calc(42deg - var(--giro, 0deg)))
      rotateX(calc(-58deg - var(--inclinacion, 0deg)))
      translate(10px, -50%);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--tinte);
  }
  .capa__nombre::before {
    content: '';
    flex: 0 0 22px;
    height: 1px;
    background: currentColor;
  }

  .ficha {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 7px;
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--tinte) 30%, transparent);
    border-radius: 13px;
    background: rgba(6, 9, 18, 0.9);
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .ficha svg { width: 34px; height: 34px; }
  .ficha span {
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--texto);
    opacity: 0.8;
  }
  .ficha[data-on] {
    transform: translateZ(30px);
    border-color: var(--tinte);
    box-shadow: 0 0 26px color-mix(in srgb, var(--tinte) 70%, transparent);
  }
  .ficha[data-on] span { opacity: 1; }

  /* una lámina resalta su capa: se separa y las demás se apagan */
  .hero[data-capa='frontend'] .capa:not([data-capa='frontend']),
  .hero[data-capa='backend'] .capa:not([data-capa='backend']),
  .hero[data-capa='datos'] .capa:not([data-capa='datos']) { opacity: 0.16; pointer-events: none; }
  .hero[data-capa='frontend'] .capa[data-capa='frontend'],
  .hero[data-capa='backend'] .capa[data-capa='backend'],
  .hero[data-capa='datos'] .capa[data-capa='datos'] { --extra: 26px; }

  /* pilares en las esquinas: una línea vertical con un paquete que la recorre */
  .pilar {
    --alto: calc(var(--salto) * 2);
    position: absolute;
    width: 2px;
    height: var(--alto);
    transform-origin: top center;
    transform: translateZ(calc(var(--salto) * -1)) rotateX(90deg);
    background: linear-gradient(rgba(255, 178, 87, 0.5), rgba(74, 222, 128, 0.5) 50%, rgba(167, 139, 250, 0.5));
    overflow: hidden;
  }
  .pilar::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 46px;
    background: linear-gradient(transparent, #fff);
    animation: subir 2.6s linear infinite;
  }
  .pilar--0 { left: calc(var(--lado) / -2); top: calc(var(--lado) / -2); }
  .pilar--1 { left: calc(var(--lado) / 2); top: calc(var(--lado) / -2); }
  .pilar--2 { left: calc(var(--lado) / 2); top: calc(var(--lado) / 2); }
  .pilar--3 { left: calc(var(--lado) / -2); top: calc(var(--lado) / 2); }
  .pilar--1::after { animation-delay: -0.9s; animation-direction: reverse; }
  .pilar--2::after { animation-delay: -1.6s; }
  .pilar--3::after { animation-delay: -0.4s; animation-direction: reverse; }
  @keyframes subir {
    from { transform: translateY(-46px); }
    to { transform: translateY(var(--alto)); }
  }

  .pila__lectura {
    --tinte: #a78bfa;
    position: absolute;
    top: clamp(24px, 9%, 84px);
    right: var(--margen);
    z-index: 6;
    display: grid;
    gap: 4px;
    min-width: 230px;
    padding: 14px 18px;
    border-left: 2px solid var(--tinte);
    background: linear-gradient(90deg, color-mix(in srgb, var(--tinte) 12%, transparent), transparent);
    transition: border-color 0.4s;
  }
  .pila__lectura b { font-size: 26px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; color: var(--texto); }
  .pila__capa {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinte);
    transition: color 0.4s;
  }
  .pila__nota { font-size: 13.5px; color: var(--mute); }

  /* pantallas bajas: el panel de lectura caería sobre la pila */
  @media (max-height: 800px) {
    .pila__lectura { display: none; }
  }
  /* portátiles: la pila se encoge y cede el margen derecho */
  @media (max-width: 1280px) {
    .pila { --lado: 276px; --salto: 156px; left: 74%; }
    .ficha svg { width: 28px; height: 28px; }
    .ficha span { font-size: 8.5px; }
    .capa__nombre,
    .pila__lectura { display: none; }
  }
  @media (max-width: 900px) {
    .pila { --lado: 250px; --salto: 112px; left: 50%; top: 23%; }
    .pila__escena { scale: 0.68; }
    .capa__nombre { display: none; }
    .capa { gap: 8px; padding: 11px; }
    .pila__lectura { display: none; }
    .hero__velo {
      background: linear-gradient(180deg, rgba(5, 7, 15, 0.35), transparent 22%, rgba(5, 7, 15, 0.82) 50%, var(--fondo) 72%);
    }
    .hero__trama {
      -webkit-mask-image: radial-gradient(80% 45% at 50% 28%, #000, transparent 75%);
      mask-image: radial-gradient(80% 45% at 50% 28%, #000, transparent 75%);
    }
  }

  /* ---------- lecturas ---------- */
  .hero__lecturas {
    position: absolute;
    bottom: calc(var(--cinta) + 26px);
    left: var(--margen);
    z-index: 6;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(18px, 2.6vw, 40px);
  }
  .lectura {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .lectura b { font-weight: 400; color: var(--texto); }
  @media (max-width: 900px) {
    .hero__lecturas { display: none; }
  }
  /* pantallas bajas: las lecturas chocarían con la portada */
  @media (max-height: 760px) {
    .hero__lecturas { display: none; }
  }

  .hero__grande {
    position: absolute;
    bottom: calc(var(--cinta) + 22px);
    right: var(--margen);
    z-index: 6;
    text-align: right;
  }
  .hero__cifra {
    display: block;
    font-size: clamp(28px, 3.4vw, 46px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--acento);
    transition: color 1s ease;
  }
  @media (max-width: 900px) {
    .hero__grande { display: none; }
  }

  /* ---------- texto ---------- */
  .hero__texto {
    position: absolute;
    left: var(--margen);
    top: 50%;
    z-index: 6;
    max-width: min(680px, 48vw);
    transform: translateY(-54%);
  }
  /* con el rail ensamblado encima, el texto se aparta para no quedar debajo */
  .hero__texto,
  .hero__lecturas { transition: translate 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  @media (min-width: 760px) and (max-width: 900px) {
    :global(html[data-rail='visible']) .hero__texto { left: calc(var(--rail) + 16px); }
  }
  @media (min-width: 901px) {
    :global(html[data-rail='visible']) .hero__texto,
    :global(html[data-rail='visible']) .hero__lecturas {
      /* solo lo justo para salir de debajo del rail; en pantallas anchas, nada */
      translate: max(0px, calc(var(--rail) + 28px - var(--margen))) 0;
    }
  }
  @media (max-width: 900px) {
    .hero__texto {
      top: auto;
      bottom: calc(var(--cinta) + 30px);
      right: 20px;
      max-width: none;
      transform: none;
    }
  }

  /* ---------- tonos por lámina ----------
     Se declaran en la sección (para lo que queda fuera de las láminas), en
     cada lámina —que así conserva sus colores mientras sale— y en cada raya. */
  .hero[data-tono='0'],
  .hero .hero__lamina[data-tono='0'],
  .hero .hero__paso[data-tono='0'] {
    --azul: #0430cf;
    --acento: #5ed3ff;
    --cta-alt-bg: #5ed3ff;
    --cta-alt-fg: #05070f;
    --trazo: rgba(94, 211, 255, 0.85);
    --relleno: linear-gradient(115deg, #2f7bff 0%, #5ed3ff 55%, #b9ecff 100%);
    --raya: linear-gradient(90deg, #2f7bff, #5ed3ff);
  }
  .hero[data-tono='1'],
  .hero .hero__lamina[data-tono='1'],
  .hero .hero__paso[data-tono='1'] {
    --azul: #6d28d9;
    --acento: #c4a1ff;
    --cta-alt-bg: #c4a1ff;
    --cta-alt-fg: #12062b;
    --trazo: rgba(196, 161, 255, 0.85);
    --relleno: linear-gradient(115deg, #8b5cf6 0%, #c4a1ff 55%, #5ed3ff 100%);
