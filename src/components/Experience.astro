  /* en reposo el frente está fuera del panel: no se pinta nada */
  .panel:not([data-nano]) .panel__haz { opacity: 0; transition: opacity 0.2s 1s; }
  .panel[data-nano] .panel__haz { opacity: 1; }

  /* ---------- rama (año) ----------
     `--eje` es la posición horizontal del tronco: centrado en escritorio,
