---
// La experiencia se dibuja como un `git log --graph`: un tronco por el que baja
// el historial, una rama por año y un commit por trabajo. Los años se paginan:
// se ve una rama a la vez y el cambio se ensambla como nanotecnología.
interface Trabajo {
  hash: string;
  fecha: string;
  rol: string;
  empresa: string;
  /** tipo de contrato o modalidad, si se conoce */
  modalidad?: string;
  enCurso?: boolean;
  descripcion?: string;
  puntos?: string[];
  tags: string[];
  /** cifra que resume el resultado, si el trabajo la tiene */
  logro?: string;
  link?: string;
}

