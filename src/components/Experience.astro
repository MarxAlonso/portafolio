const total = HISTORIAL.reduce((n, rama) => n + rama.trabajos.length, 0);
const ultima = HISTORIAL.length - 1;
---

<div class="exp zona-oscura" data-exp>
  <div class="exp__barra">
    <span class="exp__luces" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="exp__titulo">marx@portfolio: ~/experiencia</span>
    <span class="exp__resumen">{total} commits · {HISTORIAL.length} ramas</span>
  </div>

  <div class="exp__cuerpo">
    <p class="exp__comando" aria-hidden="true">
      <span class="exp__prompt"><b>marx@portfolio</b>:<i>~/experiencia</i>$</span> git log --graph{' '}
      <span data-comando-rama>--all</span>
    </p>

    <!-- paginación: un rombo por año, unidos como los pasos de un diagrama -->
    <nav class="pag" aria-label="Años de experiencia" data-pag>
      <button type="button" class="pag__flecha" data-ir="-1" aria-label="Año más reciente">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
      </button>
      <ol class="pag__anios">
        {HISTORIAL.map((rama, i) => (
          <li>
            <button
              type="button"
              class="pag__anio"
              data-pagina={i}
              style={`--tinte:${rama.tinte}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span class="pag__rombo" aria-hidden="true"></span>
              <b class="mono-num">{rama.anio}</b>
              <small>{rama.trabajos.length} commits</small>
            </button>
          </li>
        ))}
      </ol>
      <button type="button" class="pag__flecha" data-ir="1" aria-label="Año anterior">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
      </button>
    </nav>

    <!-- `--nano` es el frente de ensamblaje del panel, igual que en el rail -->
    <div class="panel" data-panel>
      <div class="grafo" data-grafo>
        {HISTORIAL.map((rama, i) => (
          <section
            class="rama"
            data-rama={i}
            data-anio={rama.anio}
            data-activa={i === 0 ? '' : undefined}
            style={`--tinte:${rama.tinte}`}
            aria-label={`Año ${rama.anio}`}
          >
            <!-- el tronco: una línea base y, encima, el tramo ya recorrido -->
            <span class="rama__tronco" aria-hidden="true"><i></i></span>

            {i === 0 && (
              <div class="rama__hito" aria-hidden="true">
                <span class="rama__etiqueta"><b>HEAD</b> → main · hoy</span>
              </div>
            )}

            <div class="rama__anio" data-paso>
              <span class="rama__rombo" aria-hidden="true"></span>
              <h3 class="rama__nombre">
                <span class="mono-num">{rama.anio}</span>
                <small>rama/{rama.anio} · {rama.trabajos.length} commits</small>
              </h3>
            </div>

            <ol class="rama__commits">
              {rama.trabajos.map((t, j) => (
                <li class:list={['commit', j % 2 === 0 ? 'commit--der' : 'commit--izq']} data-paso>
                  <span class="commit__nodo" aria-hidden="true"></span>
                  <span class="commit__cable" aria-hidden="true"></span>

                  <article class="commit__tarjeta">
                    <header class="commit__cabeza">
                      <span class="commit__hash" aria-hidden="true">commit {t.hash}</span>
                      <time class="commit__fecha">
                        {t.enCurso && <i class="commit__vivo" aria-hidden="true" />}
                        {t.fecha}
                      </time>
                    </header>

                    <h4 class="commit__rol">{t.rol}</h4>
                    <p class="commit__empresa">@ {t.empresa}</p>
                    {t.modalidad && <p class="commit__modalidad">{t.modalidad}</p>}

                    {t.descripcion && <p class="commit__descripcion">{t.descripcion}</p>}
                    {t.puntos && (
                      <ul class="commit__puntos">
                        {t.puntos.map((punto) => <li>{punto}</li>)}
                      </ul>
                    )}

                    {t.logro && <p class="commit__logro">▲ {t.logro}</p>}

                    <footer class="commit__pie">
                      <ul class="commit__tags">
                        {t.tags.map((tag) => <li>{tag}</li>)}
                      </ul>
                      {t.link && (
                        <a href={t.link} class="commit__enlace">Saber más <span aria-hidden="true">→</span></a>
                      )}
                    </footer>
                  </article>
                </li>
              ))}
            </ol>

            <div class="rama__hito rama__hito--fin" data-paso>
              {i === ultima ? (
                <span class="rama__etiqueta" aria-hidden="true"><b>init</b> · primer commit · {rama.anio}</span>
              ) : (
                <button type="button" class="rama__etiqueta rama__siguiente" data-ir="1">
                  checkout <b>rama/{HISTORIAL[i + 1].anio}</b> →
                </button>
              )}
            </div>
          </section>
        ))}
      </div>

      <span class="panel__nano" aria-hidden="true"></span>
      <span class="panel__haz" aria-hidden="true"></span>
    </div>
  </div>
</div>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-exp]');
  const panel = raiz?.querySelector<HTMLElement>('[data-panel]');
  const ramas = raiz ? [...raiz.querySelectorAll<HTMLElement>('[data-rama]')] : [];

  if (raiz && panel && ramas.length) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const espera = (ms: number) => new Promise<void>((r) => setTimeout(r, reduce ? 0 : ms));
    const botones = [...raiz.querySelectorAll<HTMLButtonElement>('[data-pagina]')];
    const flechas = [...raiz.querySelectorAll<HTMLButtonElement>('.pag__flecha')];
    const comando = raiz.querySelector<HTMLElement>('[data-comando-rama]');

    let actual = 0;
    let ocupado = false;
    // las ramas a las que se llega paginando se recorren solas; la primera, con el scroll
    const recorridas = new Set<number>();
    let raf = 0;

    const pasosDe = (rama: HTMLElement) => [...rama.querySelectorAll<HTMLElement>('[data-paso]')];

    /** Lleva el tronco de la rama hasta `cabeza` px y enciende los pasos alcanzados. */
    const recorrer = (rama: HTMLElement, cabeza: number) => {
      const caja = rama.getBoundingClientRect();
      if (!caja.height) return;
      rama.style.setProperty('--avance', Math.max(0, Math.min(1, cabeza / caja.height)).toFixed(4));
      for (const paso of pasosDe(rama)) {
        const y = paso.getBoundingClientRect().top - caja.top + 24;
        if (y <= cabeza) paso.toggleAttribute('data-on', true);
      }
    };

    const completar = (rama: HTMLElement) => {
      rama.style.setProperty('--avance', '1');
      pasosDe(rama).forEach((p) => p.toggleAttribute('data-on', true));
    };

    /** Recorre la rama de arriba abajo sin esperar al scroll. */
    const reproducir = (indice: number) => {
      const rama = ramas[indice];
      cancelAnimationFrame(raf);
      recorridas.add(indice);
      if (reduce) return completar(rama);

      const alto = rama.getBoundingClientRect().height;
      const duracion = Math.min(2600, 900 + alto * 0.9);
      const inicio = performance.now();
      const cuadro = (ahora: number) => {
        const k = Math.min(1, (ahora - inicio) / duracion);
        recorrer(rama, k * alto + 30);
        if (k < 1 && actual === indice) raf = requestAnimationFrame(cuadro);
        else if (actual === indice) completar(rama);
      };
      raf = requestAnimationFrame(cuadro);
    };

    const pintarPaginacion = () => {
      botones.forEach((b, i) => {
        if (i === actual) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
      flechas.forEach((f) => {
        const destino = actual + Number(f.dataset.ir);
        f.disabled = destino < 0 || destino >= ramas.length;
      });
      if (comando) comando.textContent = `rama/${ramas[actual].dataset.anio}`;
    };

    const irA = async (indice: number) => {
      if (ocupado || indice === actual || indice < 0 || indice >= ramas.length) return;
      ocupado = true;
      cancelAnimationFrame(raf);

      // el panel se desmonta, cambia de rama y se vuelve a ensamblar
      panel.dataset.nano = 'fuera';
      actual = indice;
      pintarPaginacion();
      await espera(520);

      ramas.forEach((r, i) => {
        r.toggleAttribute('data-activa', i === indice);
        if (i === indice) {
          r.style.setProperty('--avance', '0');
          pasosDe(r).forEach((p) => p.removeAttribute('data-on'));
        }
      });
      // si el panel quedó fuera de la vista, se vuelve a su inicio
      if (raiz.getBoundingClientRect().top < 0) {
        raiz.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }

      delete panel.dataset.nano;
      await espera(420);
      reproducir(indice);
      ocupado = false;
    };

    raiz.addEventListener('click', (e) => {
      const boton = (e.target as HTMLElement).closest<HTMLElement>('[data-pagina], [data-ir]');
      if (!boton) return;
      if (boton.dataset.pagina !== undefined) void irA(Number(boton.dataset.pagina));
      else void irA(actual + Number(boton.dataset.ir));
    });

    // con el script vivo solo se muestra la rama activa; sin él, se ven todas
    raiz.toggleAttribute('data-vivo', true);
    pintarPaginacion();

    if (reduce) {
      completar(ramas[0]);
      recorridas.add(0);
    } else {
      // la primera rama se recorre con el scroll: la cabeza va al 74 % de la ventana
      let pendiente = false;
      const medir = () => {
        pendiente = false;
        if (recorridas.has(actual)) return;
        const rama = ramas[actual];
        recorrer(rama, window.innerHeight * 0.74 - rama.getBoundingClientRect().top);
      };
      const pedir = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(medir);
      };
      window.addEventListener('scroll', pedir, { passive: true });
      window.addEventListener('resize', pedir, { passive: true });
      medir();
    }
  }
</script>

<style>
  /* ---------- ventana ---------- */
  .exp {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(7, 10, 20, 0.88);
    box-shadow: 0 40px 100px -50px rgba(4, 48, 207, 0.6);
    overflow: hidden;
    scroll-margin-top: 16px;
  }
  .exp__barra {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.035);
    font-family: var(--mono);
  }
  .exp__luces { display: flex; gap: 7px; }
  .exp__luces i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .exp__luces i:nth-child(2) { background: #febc2e; }
  .exp__luces i:nth-child(3) { background: #28c840; }
  .exp__titulo { flex: 1; text-align: center; font-size: 12px; color: var(--mute); }
  .exp__resumen { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--mute); }
  @media (max-width: 640px) {
    .exp__resumen { display: none; }
  }

  .exp__cuerpo { padding: clamp(16px, 3vw, 36px); }
  .exp__comando {
    margin-bottom: clamp(18px, 2.4vw, 26px);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--texto);
    overflow-wrap: anywhere;
  }
  .exp__prompt { color: var(--mute); }
  .exp__prompt b { font-weight: 500; color: var(--verde); }
  .exp__prompt i { font-style: normal; color: var(--acento); }

  /* ---------- paginación por año ---------- */
  .pag {
    display: flex;
    align-items: center;
    gap: clamp(6px, 1.4vw, 16px);
    margin-bottom: clamp(22px, 3vw, 36px);
    padding: 12px clamp(8px, 1.6vw, 18px);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
  }
  /* sin script no hay nada que paginar: se ven todas las ramas */
  .exp:not([data-vivo]) .pag { display: none; }

  .pag__anios {
    position: relative;
    display: flex;
    flex: 1;
    justify-content: space-between;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* la línea que une los años, a la altura de los rombos */
  .pag__anios::before {
    content: '';
    position: absolute;
    inset-inline: 12%;
    top: 13px;
    height: 2px;
    background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.18) 0 5px, transparent 5px 11px);
  }
  .pag__anios li { position: relative; flex: 1; display: flex; justify-content: center; }

  .pag__anio {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 4px clamp(4px, 1vw, 14px);
    border: 0;
    background: none;
    color: var(--mute);
    cursor: pointer;
    transition: color 0.3s;
  }
  .pag__rombo {
    width: 18px;
    height: 18px;
    border: 2px solid color-mix(in srgb, var(--tinte) 45%, transparent);
    background: var(--fondo);
    transform: rotate(45deg);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s, background-color 0.3s, box-shadow 0.3s;
  }
  .pag__anio b { font-size: clamp(15px, 1.7vw, 20px); font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
  .pag__anio small {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pag__anio:hover { color: var(--texto); }
  .pag__anio:hover .pag__rombo { border-color: var(--tinte); transform: rotate(45deg) scale(1.15); }
  .pag__anio[aria-current] { color: var(--tinte); }
  .pag__anio[aria-current] .pag__rombo {
    border-color: var(--tinte);
    background: var(--tinte);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--tinte) 18%, transparent), 0 0 20px var(--tinte);
    transform: rotate(135deg) scale(1.2);
  }
  @media (max-width: 520px) {
    .pag__anio small { display: none; }
  }

