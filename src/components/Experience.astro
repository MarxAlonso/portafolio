  .commit--izq .commit__tarjeta { grid-column: 1; margin-right: var(--cable); }

  .commit__nodo {
    position: absolute;
    left: var(--eje);
    top: 24px;
    z-index: 1;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border: 2px solid color-mix(in srgb, var(--tinte) 40%, transparent);
    border-radius: 50%;
