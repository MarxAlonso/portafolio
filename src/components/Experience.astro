---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "- Marzo 2025 - Agosto 2025",
    title: "Desarrollador Web Freelancer — 3RCore Agencia de Marketing",
    description:
      "Diseñé y desarrollé sitios web corporativos responsivos para diversos clientes de la agencia, implementando optimización de imágenes, carga asíncrona y mejoras de rendimiento que lograron reducir los tiempos de carga hasta en un 40 %. También realicé mantenimiento continuo, integración de CMS en WordPress con Elementor y Divi, y gestión de despliegues en entornos de producción.",
    link: "/",
  },
  {
    date: "- Enero 2025 - Febrero 2025",
    title: "Líder de Proyecto Web — AventuraGym",
    description:
      "Lideré el desarrollo completo de la plataforma web de AventuraGym, un gimnasio que carecía de presencia digital. Construí una aplicación web moderna e interactiva con React, TypeScript y TailwindCSS, implementando diseño responsive, navegación intuitiva y formularios de contacto integrados. El proyecto incluyó despliegue en producción y capacitación al personal para la gestión de contenido.",
    link: "AventuraGym",
  },
  {
    date: "- Febrero 2024",
    title: "Desarrollador Full-Stack — IBSeguros (CorpIBGroup)",
    description:
      "Participé activamente en la modernización y migración de IBSeguros, una plataforma crítica para la empresa. Implementé nuevas funcionalidades en Laravel y Vue.js, optimicé consultas a la base de datos MySQL y mejoré la experiencia de usuario con interfaces más ágiles y accesibles. También colaboré en la migración de la infraestructura a un entorno más escalable.",
    link: "IBSeguros",
  },
  {
    date: "- Enero 2024",
    title: "Líder de Migración — IBContrata (CorpIBGroup)",
    description:
      "Lideré la migración completa de IBContrata de Laravel 7 a Laravel 10, modernizando la arquitectura del backend, refactorizando controladores y modelos, y actualizando dependencias obsoletas. Implementé nuevas APIs RESTful, mejoré la seguridad con autenticación JWT y optimicé el rendimiento general de la plataforma, reduciendo los tiempos de respuesta en un 30 %.",
    link: "IBContrata",
  },
  {
    date: "- Diciembre 2023",
    title: "Desarrollador de Escritorio — Sistema de Gestión de Gimnasio",
    description:
      "Diseñé y desarrollé una aplicación de escritorio completa para la administración integral de un gimnasio. El sistema permite gestionar clientes, membresías, personal, equipos e inventario. Construida con Java y conectada a una base de datos MySQL, la aplicación automatizó procesos manuales, reduciendo el tiempo de administración en un 60 % y proporcionando reportes en tiempo real.",
    link: "Gimnasio",
  },
  {
    date: "- Julio 2023 - Noviembre 2023",
    title: "Desarrollador Frontend — Proyectos Web Corporativos",
    description:
      "Desarrollé múltiples sitios web corporativos y landing pages para pequeñas y medianas empresas, utilizando React, Next.js y TailwindCSS. Implementé diseños responsivos, animaciones fluidas y formularios inteligentes con validación. También configuré despliegues automatizados en Netlify, Vercel y Cloudflare Pages, garantizando alta disponibilidad y rendimiento.",
    link: "/",
  },
  {
    date: "- Enero 2023 - Junio 2023",
    title: "Desarrollador Web — Proyectos con WordPress",
    description:
      "Creé y personalicé sitios web profesionales con WordPress utilizando constructores visuales como Elementor y Divi, combinando el poder del diseño visual con bloques de código personalizados en PHP, CSS y JavaScript. Desarrollé temas hijos, optimicé la velocidad de carga con caché y compresión de imágenes, e integré plugins de SEO, comercio electrónico y formularios avanzados.",
    link: "/",
  },
];
---

<ol class="experience-list relative border-s border-gray-200 ml-3 dark:border-gray-700">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-10 ms-4 experience-item">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>

<style>
  @keyframes fadeInBlur {
    from {
      opacity: 0;
      filter: blur(10px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  .experience-item {
    opacity: 0;
    filter: blur(10px);
    transition:
      opacity 1s ease-out,
      filter 1s ease-out;
  }

  .experience-item.show {
    opacity: 1;
    filter: blur(0);
  }
</style>

<script>
  // Wait for the DOM to be fully loaded
  document.addEventListener("DOMContentLoaded", function () {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("show");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll(".experience-item").forEach((item) => {
      observer.observe(item);
    });
  });
</script>
