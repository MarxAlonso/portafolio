---
import ProjectCard from './ProjectCard.astro';
import { SISTEMAS, WEBS } from '../data/proyectos';

const PROYECTOS = [...WEBS, ...SISTEMAS];

// filtros rápidos: las tecnologías que más se repiten entre los proyectos
const conteo = new Map<string, number>();
for (const p of PROYECTOS) for (const tag of p.tags) conteo.set(tag, (conteo.get(tag) ?? 0) + 1);
const FILTROS = [...conteo.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1])
  .map(([tag]) => tag);
---

<div class="lista zona-oscura" data-lista>
  <!-- buscador: una terminal a todo el ancho; lo que se escribe filtra las tarjetas -->
  <div class="buscar">
    <div class="buscar__barra">
      <span class="buscar__luces" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="buscar__titulo">marx@portfolio: ~/proyectos</span>
      <span class="buscar__ayuda" aria-hidden="true"><kbd>/</kbd> buscar · <kbd>Esc</kbd> limpiar</span>
    </div>

    <div class="buscar__cuerpo">
      <label class="buscar__linea">
        <span class="buscar__prompt" aria-hidden="true"><b>marx@portfolio</b>:<i>~/proyectos</i>$</span>
        <span class="buscar__comando" aria-hidden="true">grep -i</span>
        <input
          class="buscar__input"
          data-buscar
          type="search"
          placeholder="nombre, tecnología o dominio…"
          aria-label="Buscar proyectos"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
        />
      </label>

      <div class="buscar__filtros" aria-label="Filtros rápidos">
        <span class="buscar__etiqueta" aria-hidden="true">--tag</span>
        <button type="button" class="buscar__filtro" data-filtro="" aria-pressed="true">todos</button>
        {FILTROS.map((tag) => (
          <button type="button" class="buscar__filtro" data-filtro={tag.toLowerCase()} aria-pressed="false">
            {tag}
          </button>
        ))}
      </div>

      <p class="buscar__estado" aria-live="polite">
        <span class="buscar__ok" aria-hidden="true">→</span>{' '}
        <span data-conteo>{PROYECTOS.length}</span> de {PROYECTOS.length} proyectos
      </p>
    </div>
  </div>

  <ul class="rejilla">
    {PROYECTOS.map((proyecto, i) => <ProjectCard proyecto={proyecto} indice={i} />)}
  </ul>

  <p class="vacio" data-vacio hidden>
    <span class="buscar__prompt"><b>grep</b>:</span> sin coincidencias para «<span data-termino></span>».
    <button type="button" class="vacio__limpiar" data-limpiar>limpiar búsqueda</button>
  </p>
</div>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-lista]');
  const entrada = raiz?.querySelector<HTMLInputElement>('[data-buscar]');

  if (raiz && entrada) {
    const tarjetas = [...raiz.querySelectorAll<HTMLElement>('[data-proyecto]')];
    const filtros = [...raiz.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
    const conteo = raiz.querySelector<HTMLElement>('[data-conteo]');
    const vacio = raiz.querySelector<HTMLElement>('[data-vacio]');
    const termino = raiz.querySelector<HTMLElement>('[data-termino]');

    const filtrar = () => {
      // cada palabra debe aparecer en la tarjeta, en cualquier orden
      const palabras = entrada.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let visibles = 0;
      for (const tarjeta of tarjetas) {
        const texto = tarjeta.dataset.busqueda ?? '';
        const coincide = palabras.every((p) => texto.includes(p));
        tarjeta.hidden = !coincide;
        if (coincide) visibles++;
      }
      if (conteo) conteo.textContent = String(visibles);
      if (vacio) vacio.hidden = visibles > 0;
      if (termino) termino.textContent = entrada.value.trim();

      const valor = entrada.value.trim().toLowerCase();
      filtros.forEach((f) => f.setAttribute('aria-pressed', String(f.dataset.filtro === valor)));
    };

    const escribir = (valor: string) => {
      entrada.value = valor;
      filtrar();
    };

    entrada.addEventListener('input', filtrar);
    raiz.addEventListener('click', (e) => {
      const objetivo = e.target as HTMLElement;
      const filtro = objetivo.closest<HTMLElement>('[data-filtro]');
      if (filtro) return escribir(filtro.dataset.filtro ?? '');
      if (objetivo.closest('[data-limpiar]')) {
        escribir('');
        entrada.focus();
      }
    });

    document.addEventListener('keydown', (e) => {
      const escribiendo = (e.target as HTMLElement).matches('input, textarea, [contenteditable]');
      if (e.key === '/' && !escribiendo) {
        e.preventDefault();
        entrada.focus();
      } else if (e.key === 'Escape' && document.activeElement === entrada) {
        escribir('');
      }
    });
  }
</script>

<style>
  .lista { display: grid; gap: clamp(22px, 3vw, 38px); }

  /* ---------- terminal de búsqueda ---------- */
  .buscar {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(7, 10, 20, 0.92);
    box-shadow: 0 30px 80px -40px rgba(4, 48, 207, 0.6);
    overflow: hidden;
    font-family: var(--mono);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .buscar:focus-within {
    border-color: var(--line-fuerte);
    box-shadow: 0 30px 80px -36px rgba(94, 211, 255, 0.55);
  }
  .buscar__barra {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.035);
  }
  .buscar__luces { display: flex; gap: 7px; }
  .buscar__luces i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .buscar__luces i:nth-child(2) { background: #febc2e; }
  .buscar__luces i:nth-child(3) { background: #28c840; }
  .buscar__titulo { flex: 1; text-align: center; font-size: 12px; color: var(--mute); }
  .buscar__ayuda { font-size: 10.5px; color: var(--mute); white-space: nowrap; }
  .buscar__ayuda kbd {
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
    font: inherit;
    color: var(--texto);
  }
  /* el atajo de teclado no existe en pantallas táctiles */
  @media (max-width: 760px), (hover: none) {
    .buscar__ayuda { display: none; }
  }

  .buscar__cuerpo { display: grid; gap: 14px; padding: clamp(14px, 2.2vw, 24px); }

  .buscar__linea {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: clamp(13px, 1.3vw, 16px);
    cursor: text;
  }
  .buscar__prompt { color: var(--mute); white-space: nowrap; }
  .buscar__prompt b { font-weight: 500; color: var(--verde); }
  .buscar__prompt i { font-style: normal; color: var(--acento); }
  .buscar__comando { color: #c792ea; white-space: nowrap; }
  .buscar__input {
    flex: 1 1 220px;
    min-width: 0;
    padding: 6px 0;
    border: 0;
    border-bottom: 1px dashed var(--line);
    outline: 0;
    background: none;
    font: inherit;
    color: var(--texto);
    caret-color: var(--acento);
    transition: border-color 0.25s;
  }
  .buscar__input:focus { border-bottom-color: var(--acento); }
  .buscar__input::placeholder { color: color-mix(in srgb, var(--mute) 70%, transparent); }
  .buscar__input::-webkit-search-cancel-button { display: none; }
  @media (max-width: 760px) {
    /* en móvil sobra el prompt completo: queda solo el `$`; 16px evita el zoom de iOS */
    .buscar__linea .buscar__prompt { display: none; }
    .buscar__comando::before { content: '$ '; color: var(--mute); }
    .buscar__input { flex-basis: 100%; font-size: 16px; }
  }

  .buscar__filtros { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .buscar__etiqueta { margin-right: 4px; font-size: 12px; color: #ffb257; }
  .buscar__filtro {
    padding: 4px 11px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: none;
    font: inherit;
    font-size: 11.5px;
    color: var(--mute);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  .buscar__filtro:hover { color: var(--acento); border-color: var(--acento); }
  .buscar__filtro[aria-pressed='true'] {
    color: var(--fondo);
    border-color: var(--acento);
    background: var(--acento);
  }

  .buscar__estado { font-size: 12px; color: var(--mute); }
  .buscar__ok { color: var(--verde); }
  .buscar__estado [data-conteo] { color: var(--texto); }

  /* ---------- rejilla ---------- */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: clamp(18px, 2.2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vacio {
    padding: 28px 20px;
    border: 1px dashed var(--line);
    border-radius: 12px;
    font-family: var(--mono);
    font-size: 13px;
    text-align: center;
    color: var(--mute);
  }
  .vacio__limpiar {
    display: block;
    margin: 12px auto 0;
    padding: 6px 14px;
    border: 1px solid var(--acento);
    border-radius: 6px;
    background: none;
    font: inherit;
    font-size: 12px;
    color: var(--acento);
    cursor: pointer;
  }
  .vacio__limpiar:hover { background: var(--acento); color: var(--fondo); }
</style>
