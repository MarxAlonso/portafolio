---
// La pila del hero, desplegada en plano: una banda por capa y un módulo por
// tecnología. Entre banda y banda corre el bus por el que viajan los datos.
import { STACK, type Capa } from '../data/stack';

/** qué resuelve cada capa y qué viaja entre ella y la siguiente */
const DETALLE: Record<Capa['id'], { rol: string; bus?: string }> = {
  frontend: { rol: 'Lo que el usuario ve y toca', bus: 'HTTP · REST · JSON' },
  backend: { rol: 'La lógica de negocio y las APIs', bus: 'SQL · Git · Deploy' },
  datos: { rol: 'Persistencia, versiones y despliegue' },
};
---

<div class="stack zona-oscura" data-stack>
  {STACK.map((capa, i) => {
    const { rol, bus } = DETALLE[capa.id];
    return (
      <Fragment>
        <section class="capa rv" style={`--tinte:${capa.tinte}`} aria-labelledby={`capa-${capa.id}`}>
          <header class="capa__cabeza">
            <div class="capa__marca">
              <span class="capa__num mono-num">0{i + 1}</span>
              <!-- las tres capas de la pila, con la actual encendida -->
              <span class="capa__nivel" aria-hidden="true">
                {STACK.map((_, n) => <i data-on={n === i ? '' : undefined} />)}
              </span>
            </div>
            <h3 class="capa__nombre" id={`capa-${capa.id}`}>{capa.nombre}</h3>
            <p class="capa__rol">{rol}</p>
            <span class="capa__cuenta">{capa.tecnologias.length} módulos</span>
          </header>

          <ul class="capa__modulos">
            {capa.tecnologias.map((t, j) => (
              <li class="modulo" style={`--marca:${t.color};--i:${j}`}>
                <span class="modulo__led" aria-hidden="true"></span>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={t.trazo} /></svg>
                <b>{t.nombre}</b>
                <span class="modulo__nota">{t.nota}</span>
              </li>
            ))}
          </ul>
        </section>

        {bus && (
          <div class="bus" style={`--de:${capa.tinte};--a:${STACK[i + 1].tinte}`} aria-hidden="true">
            <i></i>
            <i></i>
            <span>{bus}</span>
            <i></i>
            <i></i>
          </div>
        )}
      </Fragment>
    );
  })}
</div>

<script>
  // el foco de luz de cada módulo sigue al puntero
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  stack?.addEventListener('pointermove', (e) => {
    const modulo = (e.target as HTMLElement).closest<HTMLElement>('.modulo');
    if (!modulo) return;
    const caja = modulo.getBoundingClientRect();
    modulo.style.setProperty('--mx', `${e.clientX - caja.left}px`);
    modulo.style.setProperty('--my', `${e.clientY - caja.top}px`);
  });
</script>

<style>
  /* ---------- capa ---------- */
  .capa {
    position: relative;
    display: grid;
    grid-template-columns: 212px minmax(0, 1fr);
    gap: clamp(16px, 2.2vw, 30px);
    padding: clamp(14px, 2vw, 22px);
    border: 1px solid color-mix(in srgb, var(--tinte) 26%, transparent);
    border-radius: 14px;
    background:
      linear-gradient(115deg, color-mix(in srgb, var(--tinte) 10%, transparent), transparent 42%),
      rgba(7, 10, 20, 0.88);
    box-shadow: 0 40px 90px -60px var(--tinte);
  }
  /* escuadras de HUD en dos esquinas */
  .capa::before,
  .capa::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid var(--tinte);
    pointer-events: none;
  }
  .capa::before { top: -1px; left: -1px; border-right: 0; border-bottom: 0; border-top-left-radius: 14px; }
  .capa::after { right: -1px; bottom: -1px; border-left: 0; border-top: 0; border-bottom-right-radius: 14px; }

  .capa__cabeza {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-right: clamp(14px, 2vw, 26px);
    border-right: 1px dashed color-mix(in srgb, var(--tinte) 30%, transparent);
  }
  .capa__marca { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .capa__num {
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.2px var(--tinte);
  }
  .capa__nivel { display: grid; gap: 4px; }
  .capa__nivel i {
    display: block;
    width: 30px;
    height: 5px;
    border: 1px solid color-mix(in srgb, var(--tinte) 45%, transparent);
    border-radius: 2px;
    transform: skewX(-24deg);
  }
  .capa__nivel i[data-on] { background: var(--tinte); box-shadow: 0 0 12px var(--tinte); }
  .capa__nombre {
    font-size: clamp(19px, 1.9vw, 23px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--texto);
  }
  .capa__rol { font-size: 13.5px; line-height: 1.5; color: var(--mute); text-wrap: pretty; }
  .capa__cuenta {
    margin-top: auto;
    padding-top: 10px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinte);
  }

  /* ---------- módulos ---------- */
  .capa__modulos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .modulo {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 14px 14px 15px;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: rgba(11, 15, 28, 0.9);
    overflow: hidden;
    transition:
      border-color 0.3s,
      box-shadow 0.3s,
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* foco de luz bajo el puntero, del color de la marca */
  .modulo::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      170px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--marca) 26%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.35s;
  }
  /* filo inferior que se dibuja al hover */
  .modulo::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--marca);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .modulo > * { position: relative; }
  .modulo svg {
    width: 28px;
    height: 28px;
    margin-bottom: 8px;
    color: var(--marca);
    transition: filter 0.3s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .modulo b { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; color: var(--texto); }
  .modulo__nota { font-size: 12px; line-height: 1.4; color: var(--mute); text-wrap: pretty; }
  .modulo .modulo__led {
    position: absolute;
    top: 13px;
    right: 13px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    transition: background-color 0.3s, box-shadow 0.3s;
  }

  .modulo:hover {
    border-color: color-mix(in srgb, var(--marca) 70%, transparent);
    box-shadow: 0 18px 40px -26px var(--marca);
    transform: translateY(-3px);
  }
  .modulo:hover::before { opacity: 1; }
  .modulo:hover::after { transform: scaleX(1); }
  .modulo:hover svg { filter: drop-shadow(0 0 10px color-mix(in srgb, var(--marca) 70%, transparent)); transform: scale(1.08); }
  .modulo:hover .modulo__led { background: var(--marca); box-shadow: 0 0 10px var(--marca); }

  /* al revelarse la capa, sus módulos se montan uno a uno; sin JS quedan a la vista */
  .capa[data-in='true'] .modulo {
    animation: modulo-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(140ms + var(--i) * 45ms);
  }
  @keyframes modulo-in {
    from { opacity: 0; transform: translate3d(0, 14px, 0) scale(0.95); }
  }

  /* ---------- bus entre capas ---------- */
  .bus {
    display: flex;
    align-items: center;
    justify-content: space-around;
    height: 54px;
    padding-inline: 8%;
  }
  .bus span {
    padding: 4px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--fondo);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--mute);
  }
  .bus i {
    position: relative;
    align-self: stretch;
    width: 2px;
    background: linear-gradient(var(--de), var(--a));
    opacity: 0.55;
    overflow: hidden;
  }
  /* paquetes que bajan y suben entre las dos capas */
  .bus i::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 18px;
    background: linear-gradient(transparent, #fff);
    animation: bus-paquete 1.8s linear infinite;
  }
  .bus i:nth-of-type(2)::after { animation-delay: -0.7s; animation-direction: reverse; }
  .bus i:nth-of-type(3)::after { animation-delay: -1.2s; }
  .bus i:nth-of-type(4)::after { animation-delay: -0.3s; animation-direction: reverse; }
  @keyframes bus-paquete {
    from { transform: translateY(-18px); }
    to { transform: translateY(54px); }
  }

  /* portátil y móvil: la ficha de la capa pasa arriba */
  @media (max-width: 1100px) {
    .capa { grid-template-columns: minmax(0, 1fr); }
    .capa__cabeza {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 4px 16px;
      padding: 0 0 14px;
      border-right: 0;
      border-bottom: 1px dashed color-mix(in srgb, var(--tinte) 30%, transparent);
    }
    .capa__marca { grid-row: 1 / 3; gap: 14px; margin: 0; }
    .capa__nivel { display: none; }
    .capa__nombre { align-self: end; }
    .capa__rol { grid-column: 2; align-self: start; }
    .capa__cuenta { grid-area: 1 / 3 / 3; margin: 0; padding: 0; }
  }
  @media (max-width: 560px) {
    .capa__modulos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .modulo { padding: 12px 11px 13px; }
    .modulo b { font-size: 14px; }
    .capa__cuenta { display: none; }
    .bus { height: 44px; padding-inline: 0; }
    .bus span { letter-spacing: 0.14em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .capa[data-in='true'] .modulo,
    .bus i::after { animation: none; }
    .modulo,
    .modulo svg { transition: none; }
  }
</style>
